# Deployment Dockerfile for Render.
#
# Identical to the upstream Dockerfile except that the build does not run lint
# or tests. Two reasons:
#
#   1. `./build.sh backend` runs `go vet`, `go clean -cache` and the full
#      `go test ./...`, and `./build.sh frontend` runs `vue-tsc --noEmit`,
#      eslint and vitest. That is a release-pipeline workload, not something a
#      deploy should redo on every push.
#
#   2. Some tests reach third-party APIs. They only skip themselves when
#      BUILD_PIPELINE=1 is set (see executeLatestExchangeRateHandler in
#      pkg/exchangerates/common_http_exchange_rates_data_provider_test.go), so
#      in a plain Docker build they make real network calls to exchange rate
#      providers and fail whenever those are unreachable, slow or rate limited.
#
# Tests still run where they belong: locally, and in the GitHub Actions
# workflows the repository already ships.
#
# This is a separate file so the upstream Dockerfile stays untouched and
# merges cleanly.

# Build backend binary file
FROM golang:1.26.4-alpine3.24 AS be-builder
ARG RELEASE_BUILD
ARG BUILD_UNIXTIME
ARG BUILD_DATE
ENV RELEASE_BUILD=$RELEASE_BUILD
ENV BUILD_UNIXTIME=$BUILD_UNIXTIME
ENV BUILD_DATE=$BUILD_DATE
# Belt and braces: also makes the third-party API tests skip if they ever run.
ENV BUILD_PIPELINE=1
WORKDIR /go/src/github.com/mayswind/ezbookkeeping
COPY . .
RUN docker/backend-build-pre-setup.sh
RUN apk add git gcc g++ libc-dev
RUN ./build.sh backend --no-lint --no-test

# Build frontend files
FROM --platform=$BUILDPLATFORM node:24.18.0-alpine3.24 AS fe-builder
ARG RELEASE_BUILD
ARG BUILD_UNIXTIME
ARG BUILD_DATE
ARG BUILD_NODE_OPTIONS
ENV RELEASE_BUILD=$RELEASE_BUILD
ENV BUILD_UNIXTIME=$BUILD_UNIXTIME
ENV BUILD_DATE=$BUILD_DATE
ENV BUILD_PIPELINE=1
ENV NODE_OPTIONS=$BUILD_NODE_OPTIONS
WORKDIR /go/src/github.com/mayswind/ezbookkeeping
COPY . .
RUN docker/frontend-build-pre-setup.sh
RUN apk add git

# vite.config.ts embeds the commit hash with git.short() from git-rev-sync,
# which reads .git straight off the filesystem and throws
# "[git-rev-sync] no git repository found" when it finds none. Render's Docker
# build context does not include .git, so the frontend build aborts before Vite
# even starts.
#
# git-rev-sync treats a HEAD that is not a "ref: ..." line as a detached head
# and returns its contents verbatim, so a single file holding a bare SHA is
# enough. No git repository, no commit, no git binary involved.
#
# The guard leaves real checkouts alone, so a local `docker build` still reports
# the true commit. Without SOURCE_COMMIT the About page shows 0000000, which is
# cosmetic.
ARG SOURCE_COMMIT
RUN if [ ! -d .git ]; then \
      mkdir -p .git && \
      echo "${SOURCE_COMMIT:-0000000000000000000000000000000000000000}" > .git/HEAD; \
    fi

RUN ./build.sh frontend --no-lint --no-test

# Package docker image
FROM alpine:3.24.1
RUN addgroup -S -g 1000 ezbookkeeping && adduser -S -G ezbookkeeping -u 1000 ezbookkeeping
RUN apk --no-cache add tzdata
COPY docker/docker-entrypoint.sh /docker-entrypoint.sh
RUN chmod +x /docker-entrypoint.sh
RUN mkdir -p /ezbookkeeping && chown 1000:1000 /ezbookkeeping \
  && mkdir -p /ezbookkeeping/data && chown 1000:1000 /ezbookkeeping/data \
  && mkdir -p /ezbookkeeping/log && chown 1000:1000 /ezbookkeeping/log \
  && mkdir -p /ezbookkeeping/storage && chown 1000:1000 /ezbookkeeping/storage
WORKDIR /ezbookkeeping
COPY --from=be-builder --chown=1000:1000 /go/src/github.com/mayswind/ezbookkeeping/ezbookkeeping /ezbookkeeping/ezbookkeeping
COPY --from=fe-builder --chown=1000:1000 /go/src/github.com/mayswind/ezbookkeeping/dist /ezbookkeeping/public
COPY --chown=1000:1000 conf /ezbookkeeping/conf
COPY --chown=1000:1000 templates /ezbookkeeping/templates
COPY --chown=1000:1000 LICENSE /ezbookkeeping/LICENSE
USER 1000:1000
EXPOSE 8080
ENTRYPOINT ["/docker-entrypoint.sh"]
