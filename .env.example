# =============================================================================
# Environment variable template — Spendly / ezBookkeeping with Supabase
# =============================================================================
#
# Copy to `.env` and fill in the real values:
#     cp .env.example .env
#
# `.env` is gitignored. `.env.example` IS committed, so never put real
# credentials in this file.
#
# These variables override conf/ezbookkeeping.ini at runtime. The pattern is
# EBK_<SECTION>_<KEY> (see pkg/settings/setting.go).
#
# IMPORTANT: the Go binary does NOT read .env files on its own. The variables
# must be injected into the environment before starting. Use the bundled
# scripts:
#     .\scripts\with-env.ps1 go run ezbookkeeping.go server run
#     ./scripts/with-env.sh  go run ezbookkeeping.go server run
# -----------------------------------------------------------------------------


# --- Database: Supabase PostgreSQL -------------------------------------------

EBK_DATABASE_TYPE=postgres

# Host MUST include the port. Without it, startup fails with
# "database host is invalid" (pkg/datastore/datastore_container.go uses
# net.SplitHostPort).
#
# Recommended — Session pooler (IPv4, compatible with lib/pq):
#     aws-0-<region>.pooler.supabase.com:5432
#
# Transaction pooler (IPv4, port 6543): lower latency but no persistent
# prepared statements. lib/pq uses them, so it can fail with
# "prepared statement already exists". Prefer 5432 unless verified otherwise.
#
# Direct connection (db.<ref>.supabase.co:5432): IPv6-only unless you have the
# IPv4 add-on. If your network or host has no IPv6, it will not connect.
EBK_DATABASE_HOST=aws-0-us-east-1.pooler.supabase.com:5432

# On Supabase the database is always named "postgres"
EBK_DATABASE_NAME=postgres

# With the pooler the user is postgres.<project-ref>
# With a direct connection it is simply: postgres
EBK_DATABASE_USER=postgres.your_project_ref_here

# Database password (Project Settings -> Database).
# Do NOT use spaces: they are encoded as "+" and the driver reads them as a
# literal "+", not a space. Hyphens, dots and other symbols are fine.
EBK_DATABASE_PASSWD=

# Supabase requires TLS. "require" encrypts without validating the certificate
# chain. "verify-full" needs the Supabase CA and an sslrootcert parameter this
# build cannot pass directly (see docs/supabase-postgres.md).
EBK_DATABASE_SSL_MODE=require

# Connection limits. The project default is 0 = unlimited, which is dangerous
# against a pooler with a quota. Tune to your Supabase plan.
EBK_DATABASE_MAX_OPEN_CONN=10
EBK_DATABASE_MAX_IDLE_CONN=2

# The pooler closes idle connections. 4h (the default) is too long; 30 minutes
# avoids handing out already-dead connections.
EBK_DATABASE_CONN_MAX_LIFETIME=1800

# Syncs the schema from the Go structs at boot. Leave this true the first time
# so the tables get created in Supabase.
EBK_DATABASE_AUTO_UPDATE_DATABASE=true

# Set to true only for debugging: dumps every SQL statement to the log.
EBK_DATABASE_LOG_QUERY=false


# --- Security ----------------------------------------------------------------

# REQUIRED before first boot. If left empty the literal default "ezbookkeeping"
# is used. It encrypts 2FA TOTP secrets and the app-lock passcode: changing it
# later invalidates existing 2FA enrollments.
#
# Generate with:  openssl rand -base64 32
EBK_SECURITY_SECRET_KEY=


# --- Server (optional) -------------------------------------------------------

# EBK_SERVER_HTTP_PORT=8080
# EBK_SERVER_DOMAIN=localhost
# EBK_SERVER_ROOT_URL=%(protocol)s://%(domain)s:%(http_port)s/

# Each instance needs a unique id (0-255) for the UUID generator.
# EBK_UUID_SERVER_ID=0


# --- File-based secrets variant (Docker/K8s) ---------------------------------
#
# Every key also accepts the EBKCFP_<SECTION>_<KEY> form, whose value is the
# PATH to a file holding the content. It takes precedence over EBK_*.
#
# EBKCFP_DATABASE_PASSWD=/run/secrets/supabase_db_password
# EBKCFP_SECURITY_SECRET_KEY=/run/secrets/ebk_secret_key
